{
  "name": "teracota",
  "version": "0.1.0",
  "description": "Tera, uma personagem de desktop que acompanha o seu trabalho no Claude Code",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "start": "node build.mjs && electron .",
    "demo": "node dist/scripts/demo.js",
    "import-skin": "node dist/scripts/import-skin.js",
    "pack": "node build.mjs && electron-builder --win --dir",
    "pack:linux": "node build.mjs && electron-builder --linux --dir",
    "dist": "node build.mjs && electron-builder --win",
    "dist:linux": "node build.mjs && electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint",
    "check": "npm run typecheck && npm run lint && npm run test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "productName": "Teracota",
  "build": {
    "appId": "com.teracota.app",
    "productName": "Teracota",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!dist/scripts/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Teracota",
      "runAfterFinish": true
    },
    "publish": null
  },
  "author": "Thallys Morais",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyotodevIndie/teracota.git"
  },
  "bugs": {
    "url": "https://github.com/kyotodevIndie/teracota/issues"
  },
  "homepage": "https://github.com/kyotodevIndie/teracota#readme"
}
