{
  "name": "tera",
  "private": true,
  "description": "Tera, uma personagem de desktop que acompanha o seu trabalho no Claude Code",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @tera/desktop start",
    "start": "pnpm --filter @tera/desktop start",
    "build": "pnpm --filter @tera/desktop build",
    "watch": "pnpm --filter @tera/desktop watch",
    "demo": "pnpm --filter @tera/desktop demo",
    "import-skin": "pnpm --filter @tera/desktop import-skin",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome lint",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "pack": "pnpm --filter @tera/desktop pack",
    "dist": "pnpm --filter @tera/desktop dist",
    "pack:win": "pnpm --filter @tera/desktop pack:win",
    "dist:win": "pnpm --filter @tera/desktop dist:win",
    "pack:linux": "pnpm --filter @tera/desktop pack:linux",
    "audit:prod": "pnpm audit --prod",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "vitepress": "^1.6.4"
  },
  "author": "Thallys Morais",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyotodevIndie/teracota.git"
  },
  "bugs": {
    "url": "https://github.com/kyotodevIndie/teracota/issues"
  },
  "homepage": "https://github.com/kyotodevIndie/teracota#readme"
}
