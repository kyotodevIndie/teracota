{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-window-poc",
  "version": "0.0.1",
  "identifier": "dev.teracota.poc.window",
  "build": { "frontendDist": "./dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TeracotaPoC",
        "width": 320,
        "height": 440,
        "x": 200,
        "y": 200,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
