{
  "name": "@tera/desktop",
  "productName": "Teracota",
  "version": "0.1.0",
  "description": "Tera, uma personagem de desktop que acompanha o seu trabalho no Claude Code",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "start": "node build.mjs && electron .",
    "test": "vitest run",
    "demo": "node dist/scripts/demo.js",
    "import-skin": "node dist/scripts/import-skin.js",
    "pack": "node build.mjs && electron-builder --dir",
    "dist": "node build.mjs && electron-builder",
    "pack:win": "node build.mjs && electron-builder --win --dir",
    "dist:win": "node build.mjs && electron-builder --win",
    "pack:linux": "node build.mjs && electron-builder --linux --dir"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.289"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tera/agent-bridge": "workspace:*",
    "@tera/character": "workspace:*",
    "@types/node": "^26.6.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "zod": "4.6.7"
  },
  "author": "Thallys Morais",
  "license": "MIT",
  "homepage": "https://github.com/kyotodevIndie/teracota#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyotodevIndie/teracota.git"
  },
  "build": {
    "appId": "com.teracota.app",
    "productName": "Teracota",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!dist/scripts/**",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "extraResources": [
      {
        "from": "../../assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../../assets/icons/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Teracota",
      "runAfterFinish": true
    },
    "publish": null,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "../../assets/icons/icon.png"
    }
  }
}
